# Copy this file to .streamlit/secrets.toml and fill it in. Never commit secrets.toml.

# Free option (default): Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-gemini-key-here"
# GEMINI_MODEL = "gemini-3.6-flash"        # or "gemini-3.5-flash-lite" for higher free limits

# Paid option: Anthropic Claude. Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-opus-5-5"

# Which one to use when both keys are set: "gemini" or "claude".
# Left unset, Gemini is used if its key exists, otherwise Claude.
# AI_PROVIDER = "gemini"
